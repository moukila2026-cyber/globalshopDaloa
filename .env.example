# Copier ces variables dans le gestionnaire d'environnement (Vercel, serveur). Le fichier .env n'est pas chargé automatiquement.
# Chaîne de connexion Neon (de préférence l'URL « pooled », avec -pooler, et sslmode=require).
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/globalshop?sslmode=require
# Origine publique exacte du site (HTTPS). Les POST sont refusés depuis toute autre origine.
PUBLIC_ORIGIN=https://your-domain.example
# Taille du pool PostgreSQL par instance (défaut 5). Garder bas en serverless.
PG_POOL_MAX=5
# --- Espace de gestion /admin ---
# Mot de passe unique de l'équipe. Sans lui, l'espace de gestion répond 503 et reste fermé.
ADMIN_PASSWORD=changez-ce-mot-de-passe
# Clé de signature des sessions d'administration (facultatif). Si elle est absente, la clé est
# dérivée de ADMIN_PASSWORD : changer le mot de passe invalide alors les sessions en cours.
# La définir séparément permet de changer le mot de passe sans déconnecter tout le monde.
# ADMIN_SECRET=
# --- Commande WhatsApp ---
# Numéro de la boutique au format international (indicatif pays, sans « + ») ou numéro local
# ivoirien à 10 chiffres : il est normalisé pour construire les liens wa.me, par exemple
# +225 07 00 00 00 00 devient 2250700000000. Sans lui, aucun lien WhatsApp n'est proposé.
WHATSAPP_NUMBER=+2250700000000
# Vercel définit VERCEL=1 automatiquement (proxy de confiance). Pour un serveur Node derrière un proxy unique : TRUST_PROXY=1.
# TRUST_PROXY=1
PORT=3000
NODE_ENV=production
